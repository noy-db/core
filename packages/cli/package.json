{
  "name": "@noy-db/cli",
  "version": "0.10.0-pre.0",
  "description": "DEPRECATED shim — every `noydb` command now lives in `create-noy-db`'s `noy-db` bin. This package only redirects. Install create-noy-db instead.",
  "license": "Apache-2.0",
  "author": "vLannaAi <vicio@lanna.ai>",
  "homepage": "https://github.com/noy-db/core/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noy-db/core.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/noy-db/core/issues"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "noydb": "dist/bin/noydb.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json"
  },
  "peerDependencies": {
    "create-noy-db": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "create-noy-db": "workspace:*"
  },
  "keywords": [
    "noy-db",
    "cli",
    "inspect",
    "verify",
    "config",
    "scaffold",
    "monitor",
    "noydb-bundle"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
