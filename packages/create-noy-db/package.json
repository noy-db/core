{
  "name": "create-noy-db",
  "version": "0.10.0-pre.2",
  "description": "The one noy-db command line: `npm create noy-db` scaffolds a project; `noy-db` then adds collections and users, rotates keys, backs up, inspects and verifies .noydb pods, audits schemas, validates and scaffolds configs, and monitors a live store.",
  "license": "Apache-2.0",
  "author": "vLannaAi <vicio@lanna.ai>",
  "homepage": "https://github.com/noy-db/core/tree/main/packages/create-noy-db#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noy-db/core.git",
    "directory": "packages/create-noy-db"
  },
  "bugs": {
    "url": "https://github.com/noy-db/core/issues"
  },
  "type": "module",
  "bin": {
    "create-noy-db": "dist/bin/create.js",
    "noy-db": "dist/bin/noy-db.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "picocolors": "^1.1.1",
    "magicast": "^0.3.5",
    "diff": "^7.0.0",
    "@noy-db/hub": "workspace:*",
    "@noy-db/to-file": "workspace:*",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^22.0.0",
    "zod": "^4.0.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "keywords": [
    "cli",
    "config",
    "create",
    "describe",
    "encryption",
    "inspect",
    "monitor",
    "noy-db",
    "noydb-bundle",
    "nuxt",
    "nuxt4",
    "pinia",
    "pod",
    "scaffolder",
    "verify",
    "vue",
    "wizard",
    "zero-knowledge"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
