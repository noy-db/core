  "schemaVersion": 1,
  "generatedFrom": "registry/features.yaml",
  "prefixes": {
    "to-": {
      "reads": "data goes TO a backend",
      "layer": "storage destination",
      "plaintext": "never — ciphertext only",
      "trust": "The store sees ciphertext only. It cannot read your records, and it cannot run a query."
    },
    "in-": {
      "reads": "runs IN your app",
      "layer": "framework / server / dev-tool binding",
      "plaintext": "no",
      "trust": "A binding composes hub inside your app; it sees what your app already holds and performs no storage I/O."
    },
    "on-": {
      "reads": "get ON via this method",
      "layer": "unlock / auth primitive",
      "plaintext": "no",
      "trust": "An unlock method derives or releases the key on the device; it never sees records."
    },
    "as-": {
      "reads": "export AS a format",
      "layer": "portable artefact",
      "plaintext": "YES — after decryption, by design",
      "trust": "⚠️ An export sees PLAINTEXT: that is its job. The file it writes is not encrypted unless you say so. Treat the output as the data itself."
    },
    "by-": {
      "reads": "sync BY way of",
      "layer": "session-share transport",
      "plaintext": "no",
      "trust": "A transport moves ciphertext and keys between peers that already hold the secret; it decrypts nothing."
    },
    "at-": {
      "reads": "sealed AT a trusted host",
      "layer": "sealing-key provider",
      "plaintext": "scoped",
      "trust": "⚠️ The one NON-zero-knowledge family: a host YOU control (a KMS, a worker) can decrypt the slice it unseals. You trust it because it is your infrastructure."
    }
  },
