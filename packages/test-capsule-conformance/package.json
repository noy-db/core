  "license": "Apache-2.0",
  "author": "vLannaAi <vicio@lanna.ai>",
  "homepage": "https://github.com/noy-db/core/tree/main/packages/test-capsule-conformance#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noy-db/core.git",
    "directory": "packages/test-capsule-conformance"
  },
  "bugs": {
    "url": "https://github.com/noy-db/core/issues"
  },
