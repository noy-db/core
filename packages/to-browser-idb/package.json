{
  "name": "@noy-db/to-browser-idb",
  "version": "0.9.0-pre.0",
  "description": "IndexedDB adapter for noy-db with optional key obfuscation",
  "license": "Apache-2.0",
  "author": "vLannaAi <vicio@lanna.ai>",
  "homepage": "https://github.com/noy-db/core/tree/main/packages/to-browser-idb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noy-db/core.git",
    "directory": "packages/to-browser-idb"
  },
  "bugs": {
    "url": "https://github.com/noy-db/core/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json"
  },
  "peerDependencies": {
    "@noy-db/hub": "workspace:^"
  },
  "devDependencies": {
    "@noy-db/hub": "workspace:*",
    "@noy-db/ports": "workspace:*",
    "fake-indexeddb": "^6.2.5"
  },
  "keywords": [
    "noy-db",
    "adapter",
    "browser",
    "indexeddb",
    "web",
    "offline-first",
    "encryption",
    "zero-knowledge",
    "obfuscation"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
