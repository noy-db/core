    "tag": "latest"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "noy-db",
    "in-rest",
    "rest",
    "http",
    "api"
  ],
  "homepage": "https://github.com/noy-db/core/tree/main/packages/in-relay#readme",
